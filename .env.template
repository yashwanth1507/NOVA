# Nova Configuration — Environment Variables
# Copy to .env and fill in your values.
# Environment variables override config.json values (prefix: NOVA_).
#
# Quantities are cast to the type of the matching config field, so
# NOVA_CONTEXT_SIZE must be a plain integer and NOVA_TEMPERATURE a float.

# Engine: "local" or "online"
# NOVA_ENGINE=local

# Path to the local GGUF model file (relative paths resolve to the app root)
# NOVA_MODEL_PATH=models/gemma-3-1b-it-Q4_K_M.gguf

# Runtime data and caches
# NOVA_SQLITE_PATH=nova_data/nova.db
# NOVA_EMBEDDING_MODEL=all-MiniLM-L6-v2
# NOVA_EMBEDDING_CACHE_DIR=models/embeddings

# Generation
# NOVA_CONTEXT_SIZE=2048
# NOVA_TEMPERATURE=0.7
# CPU threads for local generation. 0 (default) keeps llama.cpp's own choice
# (cpu_count() // 2), which measured ~190x faster than forcing cpu_count() on a
# 4 performance + 4 efficiency core machine.
# NOVA_N_THREADS=0

# Server
# NOVA_HOST=127.0.0.1
# NOVA_PORT=8765

# OpenAI API key (required if engine is "online")
OPENAI_API_KEY=
